{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hok-agent/hierarchical-transition-v0.schema.json",
  "title": "HoK-Agent Hierarchical Transition v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "step_id",
    "policy_bundle_version",
    "policy_bundle_sha256",
    "event_engine_version",
    "event_engine_sha256",
    "observation",
    "proposals",
    "executed_action",
    "settle_end_ns",
    "next_observation",
    "events",
    "reward",
    "done",
    "terminal_reason",
    "causal_order_valid",
    "training_eligible",
    "replay"
  ],
  "properties": {
    "schema_version": {
      "const": "hok-agent-hierarchical-transition-v0"
    },
    "episode_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "step_id": {
      "type": "integer",
      "minimum": 0
    },
    "policy_bundle_version": {
      "$ref": "#/$defs/nonempty_string"
    },
    "policy_bundle_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "event_engine_version": {
      "$ref": "#/$defs/nonempty_string"
    },
    "event_engine_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "observation": {
      "$ref": "#/$defs/frame_packet"
    },
    "proposals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macro", "movement", "combat"],
      "properties": {
        "macro": {
          "allOf": [
            {"$ref": "#/$defs/proposal"},
            {
              "properties": {
                "value": {
                  "enum": [
                    "FARM_LANE",
                    "PUSH_STRUCTURE",
                    "ENGAGE",
                    "DISENGAGE",
                    "RECALL",
                    "HOLD"
                  ]
                }
              }
            }
          ]
        },
        "movement": {
          "allOf": [
            {"$ref": "#/$defs/proposal"},
            {
              "properties": {
                "value": {"enum": ["NONE", "N", "NE", "E", "SE", "S", "SW", "W", "NW"]}
              }
            }
          ]
        },
        "combat": {
          "allOf": [
            {"$ref": "#/$defs/proposal"},
            {
              "properties": {
                "value": {"enum": ["WAIT", "BASIC_ATTACK", "SKILL1", "SKILL2", "SKILL3"]}
              }
            }
          ]
        }
      }
    },
    "executed_action": {
      "$ref": "#/$defs/executed_action"
    },
    "settle_end_ns": {
      "$ref": "#/$defs/timestamp_ns"
    },
    "next_observation": {
      "$ref": "#/$defs/frame_packet"
    },
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/visual_event"}
    },
    "reward": {
      "$ref": "#/$defs/reward"
    },
    "done": {
      "type": "boolean"
    },
    "terminal_reason": {
      "enum": [
        "NOT_DONE",
        "WIN",
        "LOSS",
        "SAFETY_STOP",
        "CAPTURE_FAILURE",
        "ACTION_FAILURE",
        "TIMEOUT",
        "UNKNOWN"
      ]
    },
    "causal_order_valid": {
      "type": "boolean",
      "description": "capture_end <= decision <= dispatch_ack <= settle_end <= next_capture_start"
    },
    "training_eligible": {
      "type": "boolean"
    },
    "ineligibility_reasons": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonempty_string"},
      "uniqueItems": true
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "failure_tags", "priority"],
      "properties": {
        "source": {
          "enum": ["demo", "sim", "controller", "online", "offline_video"]
        },
        "failure_tags": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonempty_string"},
          "uniqueItems": true
        },
        "priority": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp_ns": {
      "type": "integer",
      "minimum": 0
    },
    "frame_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "capture_start_ns",
        "capture_end_ns",
        "capture_source_class",
        "frame_bundle_ref",
        "view_sha256",
        "capture_latency_ms",
        "source_locator_persisted"
      ],
      "properties": {
        "observation_id": {"$ref": "#/$defs/nonempty_string"},
        "capture_start_ns": {"$ref": "#/$defs/timestamp_ns"},
        "capture_end_ns": {"$ref": "#/$defs/timestamp_ns"},
        "capture_source_class": {
          "enum": ["pixelarena", "offline_video", "v4l2", "self_built_mobile_test_app"]
        },
        "frame_bundle_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "view_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["main", "minimap", "hud"],
          "properties": {
            "main": {"$ref": "#/$defs/sha256"},
            "minimap": {"$ref": "#/$defs/sha256"},
            "hud": {"$ref": "#/$defs/sha256"}
          }
        },
        "capture_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "source_locator_persisted": {
          "const": false
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "value",
        "confidence",
        "decision_start_ns",
        "decision_end_ns",
        "valid_until_ns",
        "policy_bundle_version"
      ],
      "properties": {
        "observation_id": {"$ref": "#/$defs/nonempty_string"},
        "value": {"$ref": "#/$defs/nonempty_string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "decision_start_ns": {"$ref": "#/$defs/timestamp_ns"},
        "decision_end_ns": {"$ref": "#/$defs/timestamp_ns"},
        "valid_until_ns": {"$ref": "#/$defs/timestamp_ns"},
        "policy_bundle_version": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "attempt_status": {
      "enum": ["not_attempted", "acknowledged", "rejected", "failed"]
    },
    "executed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_movement",
        "applied_movement",
        "requested_combat",
        "applied_combat",
        "movement_command",
        "combat_command",
        "dispatch_start_ns",
        "dispatch_ack_ns",
        "first_attempt_status",
        "retry_status",
        "retry_count",
        "final_status"
      ],
      "properties": {
        "requested_movement": {"enum": ["NONE", "N", "NE", "E", "SE", "S", "SW", "W", "NW"]},
        "applied_movement": {"enum": ["NONE", "N", "NE", "E", "SE", "S", "SW", "W", "NW"]},
        "requested_combat": {"enum": ["WAIT", "BASIC_ATTACK", "SKILL1", "SKILL2", "SKILL3"]},
        "applied_combat": {"enum": ["WAIT", "BASIC_ATTACK", "SKILL1", "SKILL2", "SKILL3"]},
        "movement_command": {"enum": ["DOWN", "MOVE", "UP", "KEEP", "NOOP"]},
        "combat_command": {"enum": ["TAP", "NOOP"]},
        "dispatch_start_ns": {"$ref": "#/$defs/timestamp_ns"},
        "dispatch_ack_ns": {"$ref": "#/$defs/timestamp_ns"},
        "first_attempt_status": {"$ref": "#/$defs/attempt_status"},
        "retry_status": {"$ref": "#/$defs/attempt_status"},
        "retry_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "final_status": {"enum": ["acknowledged", "rejected", "failed", "noop"]}
      }
    },
    "event_value": {
      "type": ["number", "string", "boolean", "null"]
    },
    "visual_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "start_ns",
        "end_ns",
        "old_value",
        "new_value",
        "delta",
        "confidence",
        "roi_id",
        "dedup_key",
        "source"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/nonempty_string"},
        "event_type": {
          "enum": [
            "GAME_END",
            "WIN",
            "LOSS",
            "DEATH",
            "RESPAWN",
            "SELF_HP_DELTA",
            "TOWER_DAMAGE",
            "TOWER_DESTROYED"
          ]
        },
        "start_ns": {"$ref": "#/$defs/timestamp_ns"},
        "end_ns": {"$ref": "#/$defs/timestamp_ns"},
        "old_value": {"$ref": "#/$defs/event_value"},
        "new_value": {"$ref": "#/$defs/event_value"},
        "delta": {"type": ["number", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "roi_id": {"$ref": "#/$defs/nonempty_string"},
        "dedup_key": {"$ref": "#/$defs/nonempty_string"},
        "source": {"enum": ["rgb_rule", "rgb_model", "rgb_ocr", "rgb_fusion"]}
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reward_version", "components", "total", "event_ids"],
      "properties": {
        "reward_version": {"$ref": "#/$defs/nonempty_string"},
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["terminal", "death", "self_hp_delta", "tower_damage"],
          "properties": {
            "terminal": {"type": "number"},
            "death": {"type": "number"},
            "self_hp_delta": {"type": "number"},
            "tower_damage": {"type": "number"}
          }
        },
        "total": {"type": "number"},
        "event_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonempty_string"},
          "uniqueItems": true
        }
      }
    }
  }
}
