{
  "schema_version": "hok-agent-t8-video-action-probe-config-v3",
  "allowed_splits": ["train", "dev"],
  "sessions_per_split": {"train": 8, "dev": 2},
  "orientation_rule": "per_session_letterbox_content_width_greater_than_height",
  "content_intensity_threshold": 5.0,
  "minimum_content_aspect_ratio": 1.5,
  "roi_radius_fraction_xy": [0.047, 0.069],
  "temporal_difference_quantile": 0.995,
  "minimum_roi_difference": 18.0,
  "minimum_roi_to_content_ratio": 1.5,
  "minimum_brightness_onset": 20.0,
  "minimum_five_frame_decay": 15.0,
  "same_button_deduplication_frames": 8,
  "cross_button_grouping_frames": 2,
  "minimum_best_to_second_score_ratio": 1.25,
  "causal_window_frames": 16,
  "minimum_train_events_per_combat_class": 50,
  "minimum_dev_events_per_combat_class": 10,
  "maximum_ambiguous_group_fraction": 0.1,
  "visual_review_samples_per_split_class": 4,
  "promotion_allowed": false
}
