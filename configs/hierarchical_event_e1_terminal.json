{
  "schema_version": "hok-agent-hierarchical-event-e1-terminal-config-v1",
  "status": "frozen_weak_label_coverage_audit",
  "selection": {
    "train_sessions": 8,
    "dev_sessions": 4,
    "test_allowed": false,
    "order": "sha256_contract_plus_candidate_id"
  },
  "sampling": {
    "tail_seconds": 24,
    "sample_hz": 1,
    "time_is_candidate_mining_only": true,
    "time_is_not_a_label": true
  },
  "ocr": {
    "engine": "ppocr-onnx-0.0.3.9",
    "minimum_confidence": 0.8,
    "win_tokens": ["胜利", "VICTORY"],
    "loss_tokens": ["失败", "DEFEAT"],
    "result_fragments": [
      "数据表现",
      "本局奖励",
      "高光时刻",
      "组队5v5王者峡谷",
      "打扫战场"
    ],
    "minimum_result_fragments_per_frame": 2,
    "arbitrary_ocr_text_persisted": false
  },
  "coverage_gate": {
    "minimum_train_game_end_coverage": 0.5,
    "minimum_dev_game_end_coverage": 0.5,
    "minimum_train_outcome_coverage": 0.5,
    "minimum_dev_outcome_coverage": 0.5,
    "maximum_outcome_conflicts": 0,
    "require_both_outcome_classes": true
  },
  "claim_boundary": {
    "weak_label_accuracy_verified": false,
    "semantic_accuracy_verified": false,
    "reward_allowed": false,
    "promotion_allowed": false,
    "video_test_allowed": false,
    "mobile_capture_allowed": false,
    "device_input_allowed": false
  }
}
